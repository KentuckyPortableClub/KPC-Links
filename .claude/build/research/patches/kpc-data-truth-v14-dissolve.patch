+def piece_family(pid):
+    """Which layer a joined record came from: PAD-US rows carry a plain number, state-layer rows a letter code + number ('sgvad346')."""
+    if isinstance(pid, int): return 'padus'
+    m = re.match(r'([a-z]+)', str(pid)); return m.group(1) if m else str(pid)
+
+
+def dissolve_pieces(pieces, tol_twin=0.02, tol_sum=0.006, same_layer_min=300):
+    """v14 (chat 8's VA / IL grade, Oct 28 10:55 PM: 'ours = the SUM of PAD-US pieces that are copies of each other'). The key
+    joins every record whose name matches, so one tract shows up to four times (PAD-US fee + PAD-US designation + two state layers),
+    and Seven Bends read 4,264 acres for a 1,052-acre park. There is no geometry in the key file, so the copies are found by their
+    acres: (1) TWINS: two records with the same acres (within 2%) are one tract when they come from different layers, or from the same
+    layer at 300+ acres (two real 40-acre survey tracts in one WMA stay two); (2) PARTS: a record whose acres equal (within 0.6%) the
+    sum of two or more smaller records is the designation record over its fee tracts: the tracts are absorbed. Tested offline on the
+    saved VA + IL files: VA agree 6 -> 39 / off 67 -> 46, IL agree 28 -> 75 / off 78 -> 44; a looser 3% parts rule over-pruned Sky
+    Meadows (1,862 ac -> 1,243), so the tolerance stays tight. Returns (kept pieces, info)."""
+    live = sorted([p for p in pieces if isinstance(p[2], (int, float)) and p[2] > 0], key=lambda p: -p[2])
+    kept = []; copies = 0
+    for p in live:
+        twin = next((k for k in kept if abs(k[2] - p[2]) / max(k[2], 1) <= tol_twin and (piece_family(k[0]) != piece_family(p[0]) or p[2] >= same_layer_min)), None)
+        if twin: copies += 1; continue
+        kept.append(p)
+    parts = 0; changed = True
+    while changed and len(kept) > 2:
+        changed = False
+        for i, big in enumerate(kept):
+            smaller = kept[i + 1:]
+            if len(smaller) < 2 or len(smaller) > 12: continue
+            for n in range(2, min(len(smaller), 8) + 1):
+                hit = next((c for c in itertools.combinations(smaller, n) if abs(sum(x[2] for x in c) - big[2]) / big[2] <= tol_sum), None)
+                if hit:
+                    kept = [k for k in kept if k not in hit]; parts += len(hit); changed = True; break
+            if changed: break
+    return kept, {'before': round(sum(p[2] for p in live)), 'after': round(sum(p[2] for p in kept)), 'copies': copies, 'parts': parts, 'records': len(live), 'tracts': len(kept)}
+
+
