   "sample": [
    {
     "description": "Fort Rouillé was built by the French military in 1750 to serve as a trading post intended to intercept the path that Indigenous traders took when carrying valuable furs to Lake Ontario and to the English post at Oswego, New York. It never saw military action, and was in use until July 1759 when the garrison of 16 men withdrew and burned the fort after the fall of Fort Niagara to the British. The outline of the palisade can be seen on the grounds of the CNE.",
     "icon_color": "g",
     "name": "Fort Rouillé",
     "pic_url": "https://services1.arcgis.com/d0ZCwU7eGKVeNiEE/arcgis/rest/services/Carrying_Place_Trail_Points/FeatureServer/0/1/attachments/1",
     "thumb_url": "https://services1.arcgis.com/d0ZCwU7eGKVeNiEE/arcgis/rest/services/Carrying_Place_Trail_Points/FeatureServer/0/1/attachments/2"
    },
    {
     "description": "The Seed-Barker Site is a Late Iroquoian (16th century)&nbsp;village strategically located along the Carrying Place Trail. Excavations have found evidence of 7 longhouses, 13 other structures, and more than 1 million artifacts. Between 1975-2005, the site was home to a number of archaeological field schools and excavated annually, contributing to the education of a generation of archaeologists.",
     "icon_color": "g",
     "name": "Seed-Barker Site",
     "pic_url": "https://services1.arcgis.com/d0ZCwU7eGKVeNiEE/arcgis/rest/services/Carrying_Place_Trail_Points/FeatureServer/0/2/attachments/3",
     "thumb_url": "https://services1.arcgis.com/d0ZCwU7eGKVeNiEE/arcgis/rest/services/Carrying_Place_Trail_Points/FeatureServer/0/2/attachments/4"
    },
    {
     "description": "Originally built by the Seneca, the historical village of Teiaiagon means “to cross”, appropriately named as the village was the last stopping point on foot before continuing the portage portion of the Carrying Place Trail. The important meeting place and trading post supported approximately 2000 Seneca and Mohawk people and was settled for several decades. The area was futher settled by the Mississauga in the 18th century.",
     "icon_color": "g",
     "name": "Teiaiagon ",
     "pic_url": "https://services1.arcgis.com/d0ZCwU7eGKVeNiEE/arcgis/rest/services/Carrying_Place_Trail_Points/FeatureServer/0/3/attachments/5",
     "thumb_url": "https://services1.arcgis.com/d0ZCwU7eGKVeNiEE/arcgis/rest/services/Carrying_Place_Trail_Points/FeatureServer/0/3/attachments/6"
    }
